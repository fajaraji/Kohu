# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules
dist/
.next/
out/

# Postgres data (local dev volumes and dumps; schema lives in api/migrations/)
data/postgres/
*.dump
*.sql.gz
pgdata/

# Hyperframes renders (video/ source stays tracked; big outputs do not)
video/renders/
video/dist/
*.mp4
*.mov
*.webm

# Meta API usage log (token and unit counts, no secrets)
logs/

# Demo clip in the corpus is tracked on purpose
!corpus/demo-app/*.mp4

# Uploaded videos and their derived files (recorded at run time)
corpus/manifest.local.json
corpus/uploads/

# Derived video frames and SAM marks: only the demo clip is tracked
corpus/derived/*
!corpus/derived/refund-process-video/
!corpus/derived/asean-outlook-report/
!video/kohu-demo.mp4
!video/assets/*.mp4
video/hyperframes/*/gsap.min.js
video/hyperframes/*/.hyperframes/
