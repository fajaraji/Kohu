# Kohu settings. Copy to .env and fill in (never commit .env):
#   cp .env.example .env
# seed.sh reads .env for any variable not already exported.

# Meta Model API key (Muse Spark 1.3, Muse Voice Transcribe 1.0, SAM 3.1).
# Without it Kohu still runs: cached model results are used and asks fall
# back to a labeled extractive answer.
META_API_KEY=
# API base and Spark model (defaults shown).
META_API_BASE=https://api.meta.ai/v1
META_PARSE_MODEL=muse-spark-1.3
# Stop calling Meta APIs once logged spend reaches this many USD.
META_SPEND_LIMIT_USD=30
# Reasoning effort for ask steps (low, medium, or empty for default).
KOHU_REASONING_EFFORT=low

# Secret that signs persona tokens. Use a long random value in production.
KOHU_SESSION_SECRET=

# Postgres 16 with pg_trgm. Local default shown. A non-local host is
# refused unless KOHU_ALLOW_REMOTE_DB=1 is also set.
DATABASE_URL=postgresql://postgres@localhost:5432/kohu
# KOHU_ALLOW_REMOTE_DB=1
